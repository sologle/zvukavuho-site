 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":404}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],"children":["$","$Lc",null,{"children":["$","$Ld",null,{"children":[["$","$L9",null,{"providerId":"page:/partners/hitach/offer","segmentMap":{"children":["__PAGE__"]},"children":["$","$La",null,{"id":"page:/partners/hitach/offer"}]}],null]}]}]}]}]}]}]}],null,null]
1:["$","main",null,{"className":"legal-page","children":[["$","a",null,{"className":"legal-back","href":"https://t.me/HITA4_bot","children":"Открыть ХИТАЧ"}],["$","article",null,{"className":"legal-document","children":[["$","h1","h1-0",{"children":"УСЛОВИЯ ИСПОЛЬЗОВАНИЯ СЕРВИСА «ХИТАЧ»"}],"\n",["$","p","p-0",{"children":"Редакция 2.0 от 09.10.2026"}],"\n",["$","p","p-1",{"children":"Настоящие Условия использования (далее — «Условия») определяют порядок использования телеграм-бота «ХИТАЧ» (@HITA4_bot, далее — «Сервис») и являются публичной офертой (ст. 437 Гражданского кодекса РФ) гражданина Сапрыкина Глеба Вячеславовича, применяющего специальный налоговый режим «Налог на профессиональный доход» (самозанятый), ИНН 773318893490 (далее — «Оператор»)."}],"\n",["$","p","p-2",{"children":["Условия доступны до покупки на публичном сайте Сервиса ",["$","a","a-0",{"href":"https://sologle.github.io/zvukavuho-site","children":"https://sologle.github.io/zvukavuho-site"}]," и по команде /terms. Начало использования Сервиса означает принятие правил его использования; оплата выбранного предложения после ознакомления с его условиями означает заключение договора на это предложение (ст. 438 ГК РФ). Перед первым оформлением Prime Пользователь также явно подтверждает условия подписки и поручение на периодические списания. Отдельное согласие на обработку персональных данных регулируется самостоятельным документом и не заменяется акцептом настоящей оферты. Если вы не согласны с Условиями, не оформляйте покупку и прекратите использование Сервиса."]}],"\n",["$","h3","h3-0",{"id":"$undefined","children":"1. Термины"}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Сервис"}]," — телеграм-бот «ХИТАЧ» и связанная с ним программная инфраструктура Оператора. Услуги оказывает указанный выше Оператор; он является исполнителем и получателем оплаты и несёт ответственность перед Пользователем."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Пользователь"}]," — физическое лицо, использующее Сервис."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Аккаунт"}]," — учётная запись Пользователя в выбранном Сервисе, привязанная к его идентификатору в Telegram. Баланс ключей, Prime, библиотека, рефералы и подарочные коды учитываются в Аккаунте Пользователя в Сервисе."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Ключи"}]," — условные единицы учёта в Сервисе, за которые выполняются платные действия: генерация трека, бита, ИИ-подбор параметров. Ключи не являются деньгами, валютой, ценной бумагой или имуществом; у них нет денежного номинала; их нельзя передать другому лицу или обменять на деньги напрямую."]}],"\n",["$","li","li-4",{"children":[["$","strong","strong-0",{"children":"Prime"}]," — платная подписка с расчётным периодом 30 дней, автосписанием и автоматическим продлением, ключами и дополнительными возможностями (редактирование параметров генерации, выгрузка WAV)."]}],"\n",["$","li","li-5",{"children":[["$","strong","strong-0",{"children":"Генерация"}]," — создание музыкальной композиции (трека) или инструментала (бита) алгоритмами искусственного интеллекта по параметрам Пользователя."]}],"\n",["$","li","li-6",{"children":[["$","strong","strong-0",{"children":"Результат"}]," — аудиофайл, созданный для Пользователя в ходе Генерации."]}],"\n",["$","li","li-7",{"children":[["$","strong","strong-0",{"children":"Внешние сервисы"}]," — привлекаемые Оператором третьи лица: Telegram, Treblo (Sonauto, Inc., США — модель синтеза музыки), OpenRouter/Google (США/ЕС — модель обработки текстовых запросов), ООО «РОБОКАССА» (приём платежей и сервис «Робочеки СМЗ»)."]}],"\n"]}],"\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47","\n","$L48","\n","$L49","\n","$L4a","\n","$L4b","\n","$L4c","\n","$L4d","\n","$L4e","\n","$L4f","\n","$L50","\n","$L51","\n","$L52","\n","$L53","\n","$L54","\n","$L55","\n","$L56","\n","$L57","\n","$L58","\n","$L59","\n","$L5a","\n","$L5b","\n","$L5c","\n","$L5d","\n","$L5e","\n","$L5f","\n","$L60","\n","$L61","\n","$L62","\n","$L63","\n","$L64","\n","$L65","\n","$L66","\n","$L67","\n","$L68","\n","$L69","\n","$L6a","\n","$L6b","\n","$L6c","\n","$L6d","\n","$L6e","\n","$L6f","\n","$L70","\n","$L71","\n","$L72","\n","$L73","\n","$L74","\n","$L75","\n","$L76","\n","$L77","\n","$L78","\n","$L79","\n","$L7a","\n","$L7b","\n","$L7c","\n","$L7d","\n","$L7e","\n","$L7f","\n","$L80"]}]]}]
e:["$","h3","h3-1",{"id":"$undefined","children":"2. Предмет и состав исполнения"}]
f:["$","p","p-3",{"children":"2.1. Оператор предоставляет доступ к функционалу Сервиса: подготовке параметров, созданию музыки средствами искусственного интеллекта, хранению проектов и получению аудиофайлов. Конкретные платные действия Пользователь заказывает и оплачивает Ключами отдельно, после отображения их стоимости и подтверждения. Само пополнение баланса не означает, что все будущие действия уже выполнены."}]
10:["$","p","p-4",{"children":"2.2. Разовый пакет Ключей учитывает предоплату будущих платных действий. Prime представляет собой единое предложение на 30 дней: доступ к дополнительным возможностям и установленное тарифом количество Ключей Prime. Отключение автопродления, досрочный отказ от оплаченного периода и отказ от отдельного заказа имеют разные последствия, описанные в разделах 6.5 и 7."}]
11:["$","p","p-5",{"children":"2.3. В объём выбранного предложения входят только прямо указанные в интерфейсе до покупки возможности. Платная повторная генерация, новый вариант и дополнительная ИИ-подготовка не включаются в предыдущий заказ автоматически. Бесплатная повторная доставка уже доступного актуального аудиофайла не является новой генерацией."}]
12:["$","p","p-6",{"children":"2.4. Сервис является самостоятельным продуктом Оператора. Генерация выполняется через API Treblo. Сервис не является официальным продуктом Treblo, Telegram, Google или Robokassa; товарные знаки этих компаний принадлежат их правообладателям. Оператор отвечает перед Пользователем за исполнение своего договора; привлечение поставщика не переносит эту ответственность на Пользователя."}]
13:["$","h3","h3-2",{"id":"$undefined","children":"3. Требования к Пользователю. Аккаунт"}]
14:["$","p","p-7",{"children":"3.1. Сервис не относится к товарам или услугам с возрастным ограничением. Если для заключения договора или оплаты в силу возраста либо дееспособности требуется согласие законного представителя, Пользователь обязан получить его до использования платных функций."}]
15:["$","p","p-8",{"children":"3.2. Аккаунт создаётся при первом запуске бота и привязан к аккаунту Telegram. Пользователь обеспечивает сохранность доступа к нему и не передаёт третьим лицам средства авторизации. При подозрении на посторонний доступ необходимо восстановить безопасность в Telegram и сообщить в поддержку Сервиса. Одного факта совершения действия из Аккаунта недостаточно для безусловного отказа в рассмотрении заявления о несанкционированном использовании."}]
16:["$","p","p-9",{"children":"3.3. Один Пользователь вправе иметь один Аккаунт в каждом боте Сервиса. Несколько аккаунтов, созданных для повторного получения welcome-, реферальных, промо- или иных однократных бонусов, нарушают Условия; полученные вследствие такого нарушения бонусы аннулируются. Балансы, подписки и покупки разных ботов не объединяются автоматически."}]
17:["$","p","p-10",{"children":"3.4. Пользователь предоставляет материалы и выбирает параметры заказа самостоятельно. Он отвечает за правомерность переданных им текстов, запросов и иных материалов, за наличие необходимых разрешений и соблюдение раздела 8 при использовании результата. Это не освобождает Оператора от его собственных обязанностей по закону."}]
18:["$","p","p-11",{"children":"3.5. Оператор вправе применять ограничения по разделу 14 при нарушении Условий или закона. Отказ от договора, законное требование возврата или обращение с претензией сами по себе не считаются злоупотреблением и не являются основанием лишить Пользователя оплаченного исполнения или обязательных способов защиты."}]
19:["$","h3","h3-3",{"id":"$undefined","children":"4. Заказ, создание и получение результата"}]
1a:["$","p","p-12",{"children":"4.1. Доступны создание песни по музыкальному направлению выбранного артиста каталога, песня на собственный текст и инструментал. Перед Генерацией Сервис показывает итоговые параметры и стоимость в Ключах. Подтверждение кнопкой «Создать» означает заказ действия по этим параметрам. Ошибочно выбранные Пользователем параметры не становятся техническим дефектом Сервиса только по причине изменения предпочтений после подтверждения."}]
1b:["$","p","p-13",{"children":"4.2. Генерация обычно занимает 2–4 минуты; это ориентир, а не гарантированный срок каждого запроса. Создание выполняется алгоритмом с вероятностным результатом. Из одного описания могут получаться разные композиции; точное совпадение с конкретной записью, голосом, мелодией или субъективным представлением Пользователя не входит в обещанный результат. Это не отменяет обязанность предоставить согласованное исполнение надлежащего качества."}]
1c:["$","p","p-14",{"children":"4.3. Услуга отдельной Генерации считается оказанной после создания результата по подтверждённому заказу и его доставки Пользователю либо фактического предоставления возможности получить аудиофайл через библиотеку Сервиса. Подтверждение оплаты, начисление или списание Ключей, постановка в очередь и запуск у внешнего поставщика сами по себе не подтверждают оказание Генерации. Недоступный или недоставленный файл не считается исполнением только потому, что запись о нём существует у поставщика."}]
1d:["$","p","p-15",{"children":"4.4. ИИ-подготовка текста или параметров и последующая Генерация могут быть самостоятельными платными действиями, если их стоимость показана до подтверждения. Подготовка считается оказанной при предоставлении её результата Пользователю; последующее изменение текста или отказ заказывать музыку не отменяют уже выполненную надлежащую подготовку. Неисполненная часть составного заказа и требования о недостатках рассматриваются отдельно."}]
1e:["$","p","p-16",{"children":"4.5. Действие «Ещё вариант» заказывает новую платную Генерацию по цене, показанной до её подтверждения, и заменяет актуальное аудио проекта. Хранение предыдущей версии в интерфейсе не гарантируется. Новое предпочтение Пользователя, желание сравнить варианты или отказаться от сохранения результата сами по себе не дают права на бесплатную повторную Генерацию. Требования, предусмотренные законом при недостатках, сохраняются."}]
1f:["$","p","p-17",{"children":"4.6. При технически несостоявшемся действии Ключи возвращаются по п. 5.4. Если результат задерживается или его невозможно получить, Пользователь может сообщить о заказе в поддержку. Сервис проверяет достоверный статус; наличие оплаченного, но неоказанного исполнения рассматривается по разделу 7, включая ситуацию, когда оплаченный срок Prime уже закончился."}]
20:["$","p","p-18",{"children":"4.7. Пока существует Аккаунт, актуальные проекты доступны в библиотеке; повторное получение доступного результата бесплатно. Пользователь самостоятельно сохраняет полученный файл, если ему нужна копия вне Telegram и Сервиса. Ограничения хранения при нарушении правил описаны в разделе 14; отсутствие собственной копии не отменяет обязательств Оператора по уже оплаченному исполнению."}]
21:["$","h3","h3-4",{"id":"$undefined","children":"5. Ключи и Prime"}]
22:["$","p","p-19",{"children":"5.1. Ключи начисляются за покупку пакетов/подписки Prime, по бонусным и реферальным программам. Бонусные Ключи начисляются добровольно и не создают оплаченной Пользователем денежной суммы. Начисление Ключей является учётной операцией, а не безусловным исполнением всех будущих услуг."}]
23:["$","p","p-20",{"children":"5.2. Подписка Prime действует 30 дней. При непрерывном продлении неиспользованные Ключи Prime переносятся на следующий период и накапливаются. После фактического завершения подписки все оставшиеся Ключи Prime аннулируются. Ключи, купленные разовыми пакетами или полученные до введения раздельного учёта, не аннулируются вместе с Prime и не имеют срока действия, пока действует настоящий договор, кроме случаев его расторжения (раздел 7)."}]
24:["$","p","p-21",{"children":"5.3. Действующие тарифы:"}]
