37:["$","ul","ul-2",{"children":["\n",["$","li","li-0",{"children":"нарушает законодательство РФ (в т.ч. экстремистская деятельность, призывы к насилию, разжигание ненависти или вражды, дискриминация);"}],"\n",["$","li","li-1",{"children":"сексуализирует несовершеннолетних или содержит иной противоправный контент;"}],"\n",["$","li","li-2",{"children":"пропагандирует наркотики, самоповреждение, суицид;"}],"\n",["$","li","li-3",{"children":"содержит клевету, оскорбления, персональные данные третьих лиц без их согласия;"}],"\n",["$","li","li-4",{"children":"нарушает авторские или смежные права третьих лиц (в т.ч. чужие тексты песен, которые вам не принадлежат)."}],"\n"]}]
