1:["$","main",null,{"className":"legal-page","children":[["$","a",null,{"className":"legal-back","href":"https://t.me/HITA4_bot","children":"Открыть ХИТАЧ"}],["$","article",null,{"className":"legal-document","children":[["$","h1","h1-0",{"children":"ПОЛИТИКА ОБРАБОТКИ ПЕРСОНАЛЬНЫХ ДАННЫХ СЕРВИСА «ХИТАЧ»"}],"\n",["$","p","p-0",{"children":"Редакция 1.7 от 03.10.2026"}],"\n",["$","p","p-1",{"children":["Настоящая Политика обработки персональных данных (далее — «Политика») составлена в соответствии с Федеральным законом от 27.07.2006 № 152-ФЗ «О персональных данных» (далее — «Закон») и определяет порядок обработки персональных данных посетителей публичного сайта ",["$","a","a-0",{"href":"https://sologle.github.io/zvukavuho-site","children":"https://sologle.github.io/zvukavuho-site"}]," и пользователей телеграм-бота «ХИТАЧ» (@HITA4_bot, далее — «Сервис»). Аккаунт, баланс, проекты и платёжная история учитываются в Сервисе."]}],"\n",["$","h3","h3-0",{"id":"$undefined","children":"1. Оператор"}],"\n",["$","p","p-2",{"children":["Оператор персональных данных — гражданин ",["$","strong","strong-0",{"children":"Сапрыкин Глеб Вячеславович"}],", применяющий специальный налоговый режим «Налог на профессиональный доход» (самозанятый), ИНН 773318893490 (далее — «Оператор»). Контакты для запросов, связанных с персональными данными: ",["$","a","a-0",{"href":"mailto:superspaingle@gmail.com","children":"superspaingle@gmail.com"}],", +7 916 826-77-53, г. Москва, поддержка в Telegram: @duffy_puffy67."]}],"\n",["$","h3","h3-1",{"id":"$undefined","children":"2. Состав обрабатываемых данных"}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"идентификатор пользователя в Telegram (ID) и имя пользователя (username);"}],"\n",["$","li","li-1",{"children":"сведения о балансе условных единиц («ключей») и истории операций с ними;"}],"\n",["$","li","li-2",{"children":"параметры проектов пользователя: запросы, темы, тексты песен и стихов, описания стиля, теги;"}],"\n",["$","li","li-3",{"children":"реферальные связи и факты использования промокодов;"}],"\n",["$","li","li-4",{"children":"события использования Сервиса: начало и завершение проекта, открытие оплаты, успешность платежа и техническая стоимость вызовов внешних сервисов без содержания запросов;"}],"\n",["$","li","li-5",{"children":"факт, сумма, статус и идентификаторы платежей; последние четыре цифры карты, если платёжный провайдер передал их для уведомления о продлении (полные данные карт Оператор не получает и не хранит: платёж проводится на стороне Robokassa);"}],"\n",["$","li","li-6",{"children":"содержание обращений в поддержку;"}],"\n",["$","li","li-7",{"children":"при посещении публичного сайта — IP-адрес, тип и версия браузера, тип устройства, дата и время запроса, запрошенный адрес страницы и технические идентификаторы, которые автоматически обрабатывает инфраструктура хостинга для доставки и защиты сайта;"}],"\n",["$","li","li-8",{"children":"локальная отметка в браузере о том, что посетитель закрыл уведомление о cookie."}],"\n"]}],"\n",["$","p","p-3",{"children":"Специальные категории персональных данных и биометрические персональные данные не обрабатываются."}],"\n",["$","h3","h3-2",{"id":"$undefined","children":"3. Цели обработки"}],"\n",["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":"заключение и исполнение договора возмездного оказания услуг (публичная оферта): предоставление доступа к функционалу Сервиса, генерация аудиофайлов, ведение баланса;"}],"\n",["$","li","li-1",{"children":"обработка платежей и оформление возвратов денежных средств;"}],"\n",["$","li","li-2",{"children":"построение агрегированной продуктовой аналитики, оценка воронки, качества Сервиса, себестоимости Генераций и расчётов по партнёрской программе;"}],"\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n"]}],"\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27"]}]]}]
