"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"display":"inline-block","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":404}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],"children":["$","$Lc",null,{"children":["$","$Ld",null,{"children":[["$","$L9",null,{"providerId":"page:/consent","segmentMap":{"children":["__PAGE__"]},"children":["$","$La",null,{"id":"page:/consent"}]}],null]}]}]}]}]}]}]}],null,null]
1:["$","main",null,{"className":"legal-page","children":[["$","a",null,{"className":"legal-back","href":"https://sologle.github.io/zvukavuho-site/","children":"← Вернуться на главную"}],["$","article",null,{"className":"legal-document","children":[["$","h1","h1-0",{"children":"СОГЛАСИЕ НА ОБРАБОТКУ ПЕРСОНАЛЬНЫХ ДАННЫХ"}],"\n",["$","p","p-0",{"children":"Редакция 1.0 от 02.09.2026"}],"\n",["$","p","p-1",{"children":"Настоящее согласие является отдельным от публичной оферты, политики обработки персональных\nданных и согласия на рекуррентные платежи документом. Пользователь даёт его свободно, своей\nволей и в своём интересе отдельным действием в интерфейсе сервиса «ЗвукаВухо»."}],"\n",["$","h3","h3-0",{"id":"$undefined","children":"1. Оператор"}],"\n",["$","p","p-2",{"children":["Оператор персональных данных — ",["$","strong","strong-0",{"children":"Сапрыкин Глеб Вячеславович"}],", самозанятый, плательщик налога\nна профессиональный доход, ИНН ",["$","strong","strong-1",{"children":"773318893490"}],", г. Москва. Контакты Оператора:\n",["$","a","a-0",{"href":"mailto:superspaingle@gmail.com","children":"superspaingle@gmail.com"}],", +7 916 826-77-53, Telegram: @duffy_puffy67."]}],"\n",["$","h3","h3-1",{"id":"$undefined","children":"2. Цели обработки"}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"регистрация и идентификация пользователя в Telegram-боте @zvukavuho_bot;"}],"\n",["$","li","li-1",{"children":"исполнение заказа: подготовка музыкального результата по запросу пользователя и его доставка;"}],"\n",["$","li","li-2",{"children":"ведение баланса ключей, истории проектов и операций;"}],"\n",["$","li","li-3",{"children":"приём платежей, рекуррентные списания Prime, направление чеков и оформление возвратов;"}],"\n",["$","li","li-4",{"children":"ответы службы поддержки, защита Сервиса от злоупотреблений и исполнение требований закона."}],"\n"]}],"\n",["$","h3","h3-2",{"id":"$undefined","children":"3. Перечень персональных данных"}],"\n",["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":"Telegram ID, имя пользователя (username) и сведения профиля, передаваемые Telegram боту;"}],"\n",["$","li","li-1",{"children":"запросы, темы, тексты, описания, теги и другие материалы, которые пользователь добровольно\nотправляет для создания результата;"}],"\n",["$","li","li-2",{"children":"сведения о проектах, балансе ключей, тарифе Prime и истории операций;"}],"\n",["$","li","li-3",{"children":"сумма, статус и идентификаторы платежей, а также последние четыре цифры карты, если их передаст\nплатёжный провайдер; полные реквизиты банковской карты Оператор не получает и не хранит;"}],"\n",["$","li","li-4",{"children":"содержание обращений в поддержку и контактные данные, добровольно указанные пользователем."}],"\n"]}],"\n",["$","p","p-3",{"children":"Оператор не запрашивает специальные категории и биометрические персональные данные. Пользователь\nне должен включать такие сведения в запросы и материалы."}],"\n",["$","h3","h3-3",{"id":"$undefined","children":"4. Действия с персональными данными и способы обработки"}],"\n",["$","p","p-4",{"children":"Согласие даётся на сбор, запись, систематизацию, накопление, хранение, уточнение (обновление,\nизменение), извлечение, использование, передачу лицам из раздела 5, обезличивание, блокирование,\nудаление и уничтожение персональных данных с использованием средств автоматизации или без них.\nОператор не распространяет персональные данные неопределённому кругу лиц и не продаёт их."}],"\n",["$","h3","h3-4",{"id":"$undefined","children":"5. Лица, привлекаемые к обработке"}],"\n",["$","p","p-5",{"children":"Для указанных целей Оператор вправе поручать обработку и передавать необходимые данные только\nв минимальном объёме следующим лицам: Telegram — доставка сообщений и файлов; Sonauto, Inc.\n(сервис Treblo) — музыкальная генерация; OpenRouter, Inc., Google LLC и Perplexity AI, Inc. —\nобработка текстовых запросов; ООО «РОБОКАССА» — приём платежей, рекуррентные списания, возвраты\nи формирование чеков; поставщики инфраструктуры Сервиса — размещение и техническая эксплуатация.\nАктуальные категории передаваемых данных приведены в политике обработки персональных данных."}],"\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15"]}]]}]
e:["$","h3","h3-5",{"id":"$undefined","children":"6. Трансграничная передача"}]
f:["$","p","p-6",{"children":"При использовании Telegram, Treblo и сервисов обработки текстовых запросов возможна\nтрансграничная передача персональных данных. Она допускается только после выполнения Оператором\nтребований статьи 12 Федерального закона № 152-ФЗ, включая необходимые уведомления\nуполномоченного органа. Первичная запись персональных данных граждан Российской Федерации должна\nосуществляться с использованием базы данных на территории Российской Федерации."}]
10:["$","h3","h3-6",{"id":"$undefined","children":"7. Срок действия согласия"}]
11:["$","p","p-7",{"children":"Согласие действует со дня его предоставления до достижения целей обработки, удаления аккаунта\nили отзыва согласия — в зависимости от того, что наступит раньше. Данные, обязательное хранение\nкоторых предусмотрено законом или необходимо для исполнения договора и расчётов между сторонами,\nобрабатываются на соответствующем самостоятельном правовом основании в установленные сроки."}]
12:["$","h3","h3-7",{"id":"$undefined","children":"8. Отзыв согласия"}]
13:["$","p","p-8",{"children":["Пользователь вправе отозвать согласие, направив заявление на ",["$","a","a-0",{"href":"mailto:superspaingle@gmail.com","children":"superspaingle@gmail.com"}]," или сообщение\nв Telegram @duffy_puffy67 с указанием своего Telegram ID. Оператор прекращает обработку,\nоснованную на согласии, и удаляет данные в предусмотренный законом срок, если отсутствует иное\nзаконное основание для их обработки. Отзыв не влияет на законность обработки, выполненной до его\nполучения, и может сделать дальнейшее предоставление Сервиса невозможным."]}]
14:["$","h3","h3-8",{"id":"$undefined","children":"9. Подтверждение пользователя"}]
15:["$","p","p-9",{"children":"Отмечая отдельный пункт «Я отдельно даю согласие на обработку моих персональных данных» в боте,\nпользователь подтверждает, что прочитал настоящий документ, понимает цели, состав, действия,\nсроки и порядок отзыва согласия. Сервис фиксирует версию документа, дату и время подтверждения,\nTelegram ID пользователя и связь подтверждения с соответствующим платёжным заказом."}]
